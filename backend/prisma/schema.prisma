generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DocumentRecord {
  id         String   @id @default(cuid())
  collection String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
  @@map("document_records")
}

enum UserRole {
  USER
  ADMIN
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  ABANDONED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  PAYPAL
  STRIPE
  UPI
  BANK
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
}

enum TournamentStatus {
  DRAFT
  OPEN
  ACTIVE
  COMPLETED
  CANCELED
}

enum CommunityPostType {
  ANNOUNCEMENT
  FEEDBACK
  BUG
  FEATURE
  DISCUSSION
}

enum CommunityPostStatus {
  OPEN
  REVIEWING
  RESOLVED
  CLOSED
}

enum ConversationType {
  PUBLIC
  PRIVATE
}

model User {
  id                         String    @id @default(cuid())
  mongoUserId                String?   @unique
  email                      String    @unique
  username                   String    @unique
  displayName                String?
  passwordHash               String?
  role                       UserRole  @default(USER)
  rating                     Int       @default(1200)
  isPremium                  Boolean   @default(false)
  emailVerified              Boolean   @default(false)
  refreshTokenHash           String?
  tokenVersion               Int       @default(0)
  emailVerificationTokenHash String?
  emailVerificationExpires   DateTime?
  passwordResetTokenHash     String?
  passwordResetExpires       DateTime?
  deletedAt                  DateTime?
  lastLogin                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  gamesAsWhite  Game[]         @relation("WhitePlayer")
  gamesAsBlack  Game[]         @relation("BlackPlayer")
  payments      Payment[]
  subscriptions Subscription[]
  referralsMade Referral[]     @relation("Referrer")
  referralsUsed Referral[]     @relation("ReferredUser")
  tournaments   Tournament[]   @relation("TournamentCreator")

  @@index([email])
  @@index([username])
  @@index([deletedAt])
}

model Game {
  id            String      @id @default(cuid())
  mongoGameId   String?     @unique
  whitePlayerId String?
  blackPlayerId String?
  whitePlayer   User?       @relation("WhitePlayer", fields: [whitePlayerId], references: [id], onDelete: SetNull)
  blackPlayer   User?       @relation("BlackPlayer", fields: [blackPlayerId], references: [id], onDelete: SetNull)
  status        GameStatus  @default(WAITING)
  result        GameResult?
  pgn           String?
  fen           String?
  moves         Json?
  timeControl   String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([status])
}

model CommunityPost {
  id              String              @id @default(cuid())
  authorId        String?
  authorName      String
  authorSupporter Boolean             @default(false)
  type            CommunityPostType   @default(DISCUSSION)
  status          CommunityPostStatus @default(OPEN)
  title           String
  body            String
  isPublic        Boolean             @default(true)
  isHidden        Boolean             @default(false)
  isPinned        Boolean             @default(false)
  likes           String[]            @default([])
  comments        Json                @default("[]")
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([isPublic, isHidden])
  @@index([isPinned, createdAt])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(PRIVATE)
  roomKey       String?
  title         String?
  participants  String[]         @default([])
  messages      Json             @default("[]")
  mutedBy       String[]         @default([])
  blockedBy     String[]         @default([])
  reports       Json             @default("[]")
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([type, roomKey])
  @@index([type])
  @@index([lastMessageAt])
}

model PremiumPlan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceCents   Int
  currency     String   @default("USD")
  interval     String
  amountInr    Int?
  amountUsd    Int?
  durationDays Int?
  benefits     Json?
  entitlements Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Payment {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider @default(MANUAL)
  amountCents    Int
  currency       String          @default("USD")
  transactionRef String?
  proofUrl       String?
  notes          String?
  metadata       Json?
  reviewedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String?
  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  expiresAt  DateTime?
  canceledAt DateTime?
  metadata   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

model Referral {
  id             String         @id @default(cuid())
  code           String
  referrerId     String
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String?
  referredUser   User?          @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(PENDING)
  rewardNote     String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([referrerId, referredUserId])
  @@index([code])
}

model Tournament {
  id          String           @id @default(cuid())
  creatorId   String?
  creator     User?            @relation("TournamentCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  name        String
  status      TournamentStatus @default(DRAFT)
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([creatorId])
  @@index([status])
}

model Puzzle {
  id         String   @id @default(cuid())
  externalId String?  @unique
  fen        String
  moves      String[]
  rating     Int?
  themes     String[]
  source     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempts PuzzleAttempt[]
}

model PuzzleAttempt {
  id        String   @id @default(cuid())
  puzzleId  String
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  userId    String?
  success   Boolean
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([puzzleId])
  @@index([userId])
}

model Stats {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
