NODE_ENV=development
PORT=3001

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/chessplay

# JWT: use two different 32+ char secrets in production
JWT_ACCESS_SECRET=replace-with-random-access-secret-32-plus-chars
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-32-plus-chars
# Backward-compatible local fallback only. Prefer the two secrets above.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Cookie/CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example: FRONTEND_ORIGINS=https://getchessplay.vercel.app
# Leave COOKIE_DOMAIN empty unless frontend and backend share a parent domain.
COOKIE_DOMAIN=
HEALTH_SECRET=

# Auth hardening
AUTH_ALLOWED_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,icloud.com,protonmail.com,aol.com,zoho.com,mail.com,gmx.com,yandex.com,tutanota.com,fastmail.com,hushmail.com,mailfence.com,runbox.com,posteo.net,countermail.com,startmail.com,disroot.org,mailbox.org,lavabit.com,safe-mail.net
GOOGLE_CLIENT_ID=

# Email provider - connect SMTP/Resend/SendGrid before public launch
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ChessPlay <no-reply@getchessplay.com>"

# Chat moderation
BLOCKED_WORDS=

# Monitoring
SENTRY_DSN=
