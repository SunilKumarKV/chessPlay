{
  "name": "backend",
  "version": "1.4.0-beta",
  "description": "Real-time multiplayer chess game backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "tsx src/scripts/seedPremiumPlans.ts",
    "prisma:studio": "prisma studio",
    "import:puzzles": "tsx src/scripts/importLichessPuzzles.ts",
    "seed:puzzles:sample": "tsx src/scripts/seedSamplePuzzles.ts",
    "puzzles:stats": "tsx src/scripts/puzzleStats.ts",
    "test": "find . \\( -path ./node_modules -o -path ./dist \\) -prune -o -name '*.js' -exec node -c {} \\;",
    "make-admin": "tsx src/scripts/make-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "socket.io": "^4.7.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "nodemon": "^3.0.2",
    "prisma": "^7.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "10.15.0"
  },
  "packageManager": "pnpm@10.15.0"
}
