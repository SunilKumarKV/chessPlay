{
  "name": "backend",
  "version": "1.4.0-beta",
  "description": "Real-time multiplayer chess game backend",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run typecheck && pnpm exec tsx --test tests/authCore.test.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "tsx src/scripts/seedPremiumPlans.ts",
    "prisma:studio": "prisma studio",
    "import:puzzles": "node scripts/importLichessPuzzles.js",
    "seed:puzzles:sample": "node scripts/seedSamplePuzzles.js",
    "puzzles:stats": "node scripts/puzzleStats.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "socket.io": "^4.7.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.25",
    "nodemon": "^3.0.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "10.15.0"
  },
  "packageManager": "pnpm@10.15.0"
}