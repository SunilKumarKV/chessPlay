{
  "name": "chessplay-monorepo",
  "version": "1.3.0-beta",
  "description": "Real-time multiplayer chess game with React frontend and Node.js backend",
  "packageManager": "pnpm@11.0.3",
  "scripts": {
    "dev": "pnpm -C frontend dev",
    "dev:multi": "concurrently \"pnpm -C frontend dev\" \"pnpm -C backend dev\"",
    "server": "pnpm -C backend dev",
    "build": "pnpm -C frontend build",
    "lint": "pnpm -C frontend lint",
    "test": "pnpm test:production && pnpm -C backend test",
    "test:production": "node TEST_PRODUCTION_SMOKE.js && node TEST_STOCKFISH.js",
    "preview": "pnpm -C frontend preview",
    "install:all": "pnpm install",
    "start": "pnpm dev:multi",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "phase8:check": "pnpm install && pnpm run test:production && pnpm build && pnpm --filter backend test && pnpm --filter backend exec prisma generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "stockfish.js": "^10.0.2"
  }
}
