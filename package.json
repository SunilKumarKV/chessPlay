{
  "name": "chessplay-monorepo",
  "version": "1.4.0-beta",
  "description": "Real-time multiplayer chess game with React frontend and Node.js backend",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:multi": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "server": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm test:production && pnpm --filter backend test",
    "test:production": "node TEST_PRODUCTION_SMOKE.js && node TEST_STOCKFISH.js",
    "test:prod-smoke": "playwright test tests/production-smoke.spec.ts",
    "preview": "pnpm --filter frontend preview",
    "install:all": "pnpm install",
    "start": "pnpm dev:multi",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "helmet": "^8.2.0",
    "morgan": "^1.10.1",
    "stockfish.js": "^10.0.2"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "10.15.0"
  }
}
