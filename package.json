{
  "name": "chessplay-monorepo",
  "version": "1.3.0",
  "description": "Real-time multiplayer chess game with React frontend and Node.js backend",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:multi": "concurrently \"pnpm -C frontend dev\" \"pnpm -C backend dev\"",
    "server": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "pnpm test:production && pnpm -C backend test",
    "test:production": "node TEST_PRODUCTION_SMOKE.js && node TEST_STOCKFISH.js",
    "preview": "npm --prefix frontend run preview",
    "install:all": "pnpm install",
    "start": "pnpm dev:multi",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "stockfish.js": "^10.0.2"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  }
}
